{
  // DICOM series descriptions that are ignored by the converter.
  "ignored-series": [
    "AAHead_Scout_32ch-head-coil",
    "AAHead_Scout_32ch-head-coil_MPR_sag",
    "AAHead_Scout_32ch-head-coil_MPR_tra",
    "AAHead_Scout_32ch-head-coil_MPR_cor",
    "ADD_RUN1-4",
    "PhoenixZIPReport"
  ],
  // Literal suffixes removed before matching a series to a BIDS acquisition.
  "trim-series-suffixes": [
    "_Pha",
    "_Motion"
  ],
  "derivatives": {
    "romeo": {
      "name": "romeo",
      "dataset-description": "dataset_descriptions/romeo.json"
    },
    "aspire": {
      "name": "aspire",
      "dataset-description": "dataset_descriptions/aspire.json"
    }
  },
  "references": {
    "up-excitation": {
      "text": "Gras et al. (2017). Homogeneous non-selective and slice-selective parallel-transmit excitations at 7 Tesla with universal pulses: A validation study on two commercial RF coils.",
      "url": "https://doi.org/10.1371/journal.pone.0183562"
    },
    "up-refocusing": {
      "text": "Gras et al. (2018). Design of universal parallel-transmit refocusing kT-point pulses and application to 3D T2-weighted imaging at 7T.",
      "url": "https://doi.org/10.1002/mrm.27001"
    },
    "up-flair": {
      "text": "Gras et al. (2019). Robust nonadiabatic T2 preparation using universal parallel-transmit kT-point pulses for 3D FLAIR imaging at 7 T.",
      "url": "https://doi.org/10.1002/mrm.27645"
    },
    "universal-pulses": {
      "text": "Gras et al. (2017). Universal pulses: A new concept for calibration-free parallel transmission.",
      "url": "https://doi.org/10.1002/mrm.26148"
    },
    "up-off-resonance": {
      "text": "Van Damme et al. (2021). Universal nonselective excitation and refocusing pulses with improved robustness to off-resonance for Magnetic Resonance Imaging at 7 Tesla with parallel transmission.",
      "url": "https://doi.org/10.1002/mrm.28441"
    },
    "travelling-pulses": {
      "text": "Wu et al. (2018). The travelling pulses: multicenter evaluation of universal pulses at 7T. ISMRM abstract 1133.",
      "url": "https://archive.ismrm.org/2018/1133.html"
    },
    "aspire": {
      "text": "Eckstein et al. (2018). Computationally efficient combination of multi-channel phase data from multi-echo acquisitions (ASPIRE).",
      "url": "https://doi.org/10.1002/mrm.26963"
    },
    "clear-swi": {
      "text": "Eckstein K, Bachrata B, Hangel G, Widhalm G, Enzinger C, Barth M, Trattnig S, Robinson SD. Improved susceptibility weighted imaging at ultra-high field using bipolar multi-echo acquisition and optimized image processing: CLEAR-SWI. NeuroImage. 2021;237:118175.",
      "url": "https://doi.org/10.1016/j.neuroimage.2021.118175"
    },
    "romeo": {
      "text": "Dymerska et al. (2021). Phase unwrapping with a rapid opensource minimum spanning tree algorithm (ROMEO).",
      "url": "https://doi.org/10.1002/mrm.28563"
    },
    "t2star-quantification": {
      "text": "Hagberg et al. (2002). Real-time quantification of T(2)(*) changes using multiecho planar imaging and numerical methods.",
      "url": "https://doi.org/10.1002/mrm.10283"
    }
  },
  "mappings": [
