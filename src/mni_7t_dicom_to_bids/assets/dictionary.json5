      "filename": "acq-aspire_rec-echoCombined_T2starw"
    },
    {
      "series": ".*sensitivity_corrected_mag_anat-T2star_acq-me_gre_0.*7iso_ASPIRE",
      "datatype": "anat",
      "filename": "acq-aspire_rec-echoCombinedSensitivityCorrected_T2starw"
    },
    {
      "series": ".*T2Star_Images",
      "datatype": "anat",
      "filename": "T2map"
    },
    {
      "series": ".*anat-T2star_acq-me_gre_07mm.*",
      "datatype": "anat",
      "filename": "acq-me_T2starw"
    },
    // 0.7 mm MP2RAGE
    {
      "series": ".*anat-T1w_acq-mp2rage_0.*7mm_CSptx_INV1",
