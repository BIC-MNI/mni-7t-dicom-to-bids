{
  // DICOM series descriptions that are ignored by the converter.
  "ignored-series": [
    "AAHead_Scout_32ch-head-coil",
    "AAHead_Scout_32ch-head-coil_MPR_sag",
    "AAHead_Scout_32ch-head-coil_MPR_tra",
    "AAHead_Scout_32ch-head-coil_MPR_cor",
    "ADD_RUN1-4",
    "PhoenixZIPReport"
  ],
  // Literal suffixes removed before matching a series to a BIDS acquisition.
  "trim-series-suffixes": [
    "_Pha",
    "_Motion"
  ],
  "mappings": [
    // Anatomical images
    // FLAIR
    {
      "series": "anat-flair_acq-0.*7iso_UPAdia",
      "datatype": "anat",
      "filename": "FLAIR"
    },
    {
      "series": "anat-flair_acq-0.*7mm_UPAdia",
      "datatype": "anat",
      "filename": "FLAIR"
    },
    {
      "series": "anat-flair_acq-0.*7iso_dev3_5SD_UP",
      "datatype": "anat",
      "filename": "FLAIR"
    },
    // UNIT1
    {
      "series": ".*anat-T1w_acq-mp2rage_0.*7mm_CSptx_UNI_Images",
      "datatype": "anat",
      "filename": "acq-07mm_UNIT1"
    },
    {
      "series": ".*anat-T1w_acq-mp2rage_0.*7mm_CSptx_UNI-DEN",
      "datatype": "anat",
      "filename": "desc-denoised_UNIT1"
    },
    // T1
    {
      "series": ".*anat-T1w_acq-mp2rage_0.*7mm_CSptx_T1_Images",
      "datatype": "anat",
      "filename": "acq-07mm_T1map"
    },
    {
      "series": "anat-T1w_acq_mprage_0.*8mm_CSptx",
      "datatype": "anat",
      "filename": "T1w"
    },
    {
      "series": "anat-T1w_acq_mprage_0.*8mm_CSx_ND",
      "datatype": "anat",
      "filename": "T1w"
    },
    {
      "series": ".*anat-T1w_acq-mprage_0.*7mm_UP",
      "datatype": "anat",
      "filename": "T1w"
    },
    // T2 and T2-star
    {
      "series": ".*CLEAR-SWI_anat-T2star_acq-me_gre_0.*7iso_ASPIRE",
      "datatype": "anat",
      "filename": "acq-SWI_T2starw"
    },
    {
      "series": ".*Romeo_P_anat-T2star_acq-me_gre_0.*7iso_ASPIRE",
      "datatype": "anat",
      "filename": "acq-romeo_T2starw",
      "merge-images": true
    },
    {
      "series": ".*Romeo_Mask_anat-T2star_acq-me_gre_0.*7iso_ASPIRE",
      "datatype": "anat",
      "filename": "acq-romeo_rec-mask_T2starw"
    },
    {
      "series": ".*Romeo_B0_anat-T2star_acq-me_gre_0.*7iso_ASPIRE",
      "datatype": "anat",
      "filename": "acq-romeo_rec-unwrapped_T2starw"
    },
    {
      "series": "Aspire_M_anat-T2star_acq-me_gre_0.*7iso_ASPIRE",
      "datatype": "anat",
      "filename": "acq-aspire_T2starw",
      "merge-images": true
    },
    {
      "series": "Aspire_P_anat-T2star_acq-me_gre_0.*7iso_ASPIRE",
      "datatype": "anat",
      "filename": "acq-aspire_T2starw",
      "merge-images": true
    },
    {
      "series": ".*T2star_anat-T2star_acq-me_gre_0.*7iso_ASPIRE",
